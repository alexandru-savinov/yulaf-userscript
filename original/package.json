{
  "name": "yulaf-youtube-language-filter",
  "version": "2.2.5",
  "description": "YouTube Language Filter - Filter YouTube content by language",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\""
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@vitest/ui": "^2.1.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.4.2",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "youtube",
    "language",
    "filter",
    "chrome-extension"
  ],
  "author": "Vakkas Karakurt & Emrah Fidan",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/vakkaskarakurt/YuLaF-YouTube-Language-Filter"
  },
  "dependencies": {}
}
